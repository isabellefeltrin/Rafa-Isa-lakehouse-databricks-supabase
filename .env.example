# Copie para .env (o .env está no .gitignore e NUNCA deve ir para o GitHub)
# URI do Session pooler do Supabase (Connect > Session pooler)
PG_URI=postgresql://postgres.<id-do-projeto>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require

# Só para o Plano B (scripts/extrair_supabase_para_volume.py)
DATABRICKS_HOST=https://<seu-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<token-pessoal>
